{
  "name": "wanxiang-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:receipt && npm run test:finance && npm run test:finance-conversation && npm run test:intake-fidelity",
    "test:receipt": "tsx tests/receipt-reconciliation.test.ts && tsx tests/receipt-resolver.test.ts",
    "test:finance": "tsx tests/finance-query.test.ts",
    "test:finance-conversation": "tsx tests/finance-conversation.test.ts",
    "test:intake-fidelity": "tsx tests/intake-fidelity.test.ts",
    "finance:recovery:plan": "tsx scripts/generate-finance-fidelity-recovery.ts",
    "db:migrate:local": "wrangler d1 migrations apply wanxiang-cloud-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply wanxiang-cloud-dev --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "undici": "^8.10.1",
    "wrangler": "^4.34.0"
  }
}
