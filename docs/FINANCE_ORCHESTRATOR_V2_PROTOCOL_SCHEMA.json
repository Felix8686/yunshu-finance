{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanxiang.local/schemas/finance-orchestrator-v2.json",
  "title": "Wanxiang Finance Orchestrator V2 Protocol Bundle",
  "$defs": {
    "FinanceActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ledger_scope_id", "subject_id", "auth_source"],
      "properties": {
        "schema_version": {"const": 1},
        "ledger_scope_id": {"const": "personal:primary"},
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "auth_source": {"enum": ["telegram_owner", "api_owner", "system_receipt"]},
        "permissions": {
          "type": "array",
          "items": {"enum": ["finance:read", "finance:write", "finance:receipt"]},
          "uniqueItems": true,
          "maxItems": 3
        }
      }
    },
    "FinanceTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "turn_id", "channel", "channel_event_id", "actor", "session_key", "ordering_key", "event_time", "received_time", "timezone", "payload_hash", "correlation_id"],
      "properties": {
        "schema_version": {"const": 1},
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "channel": {"enum": ["telegram", "api", "receipt"]},
        "channel_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "actor": {"$ref": "#/$defs/FinanceActor"},
        "session_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "thread_id": {"type": ["string", "null"], "maxLength": 128},
        "topic_id": {"type": ["string", "null"], "maxLength": 128},
        "ordering_key": {"type": "integer", "minimum": 0},
        "event_time": {"type": "string", "format": "date-time"},
        "received_time": {"type": "string", "format": "date-time"},
        "timezone": {"const": "Asia/Shanghai"},
        "text": {"type": ["string", "null"], "maxLength": 4000},
        "attachment_refs": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 4},
        "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "causation_turn_id": {"type": ["string", "null"], "maxLength": 128},
        "base_session_version": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_fen", "currency"],
      "properties": {
        "amount_fen": {"type": "integer", "minimum": 1, "maximum": 100000000000},
        "currency": {"const": "CNY"}
      }
    },
    "TemporalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "timezone"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"},
        "timezone": {"const": "Asia/Shanghai"},
        "source_phrase": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "CatalogReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["category", "account", "merchant"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "ReferenceSpec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "result_set_id", "ordinal"],
          "properties": {
            "kind": {"const": "result_ordinal"},
            "result_set_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "ordinal": {"type": "integer", "minimum": 1, "maximum": 200}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation_id"],
          "properties": {
            "kind": {"const": "operation"},
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "receipt_artifact_id"],
          "properties": {
            "kind": {"const": "receipt"},
            "receipt_artifact_id": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "transaction_id"],
          "properties": {
            "kind": {"const": "transaction"},
            "transaction_id": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item_id"],
          "properties": {
            "kind": {"const": "transaction_item"},
            "item_id": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "semantic_key"],
          "properties": {
            "kind": {"const": "session_semantic"},
            "semantic_key": {"enum": ["last_created", "last_updated", "last_deleted", "last_restored", "last_receipt", "active_result_set", "previous_result_set"]}
          }
        }
      ]
    },
    "CreateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "line_total_fen", "category"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "quantity": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "unit_price_fen": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000000},
        "line_total_fen": {"type": "integer", "minimum": 0, "maximum": 100000000000},
        "category": {"enum": ["食品", "饮料", "生鲜", "零食", "日用品", "清洁用品", "个护", "医药健康", "母婴", "宠物", "家居", "数码配件", "服饰", "其他"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "CreateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "money", "occurred_at"],
      "properties": {
        "type": {"enum": ["expense", "income", "transfer"]},
        "money": {"$ref": "#/$defs/Money"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "account": {"anyOf": [{"$ref": "#/$defs/CatalogReference"}, {"type": "null"}]},
        "category": {"anyOf": [{"$ref": "#/$defs/CatalogReference"}, {"type": "null"}]},
        "merchant": {"type": ["string", "null"], "maxLength": 256},
        "description": {"type": ["string", "null"], "maxLength": 512},
        "items": {"type": "array", "items": {"$ref": "#/$defs/CreateItem"}, "maxItems": 64}
      }
    },
    "FinanceFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {"type": "array", "items": {"enum": ["expense", "income", "transfer"]}, "uniqueItems": true, "maxItems": 3},
        "categories": {"type": "array", "items": {"$ref": "#/$defs/CatalogReference"}, "maxItems": 16},
        "accounts": {"type": "array", "items": {"$ref": "#/$defs/CatalogReference"}, "maxItems": 16},
        "merchant_text": {"type": ["string", "null"], "maxLength": 128},
        "semantic_text": {"type": ["string", "null"], "maxLength": 256},
        "amount_min_fen": {"type": ["integer", "null"], "minimum": 0},
        "amount_max_fen": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "FinanceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["exactly_one", "exact_count", "all_matching", "reference"]},
        "count": {"type": ["integer", "null"], "minimum": 1, "maximum": 50},
        "reference": {"anyOf": [{"$ref": "#/$defs/ReferenceSpec"}, {"type": "null"}]}
      }
    },
    "FinancePresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["details", "summary", "analysis", "comparison"]},
        "fields": {"type": "array", "items": {"enum": ["date", "time", "item", "amount", "category", "account", "merchant", "type"]}, "uniqueItems": true, "maxItems": 8},
        "sort_field": {"enum": ["occurred_at", "amount", "item", "category", "account"]},
        "sort_direction": {"enum": ["asc", "desc"]},
        "group_by": {"enum": ["none", "date", "category", "account", "merchant"]},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 20},
        "page_token": {"type": ["string", "null"], "maxLength": 256},
        "compact": {"type": "boolean"}
      }
    },
    "ItemPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"$ref": "#/$defs/ReferenceSpec"},
        "name": {"type": ["string", "null"], "maxLength": 256},
        "quantity": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 10000},
        "unit_price_fen": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000000},
        "line_total_fen": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000000},
        "category": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "FinanceChanges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount_fen": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000000000},
        "currency": {"enum": ["CNY"]},
        "occurred_at": {"type": ["string", "null"], "format": "date-time"},
        "account": {"anyOf": [{"$ref": "#/$defs/CatalogReference"}, {"type": "null"}]},
        "category": {"anyOf": [{"$ref": "#/$defs/CatalogReference"}, {"type": "null"}]},
        "merchant": {"type": ["string", "null"], "maxLength": 256},
        "description": {"type": ["string", "null"], "maxLength": 512},
        "item_patch": {"anyOf": [{"$ref": "#/$defs/ItemPatch"}, {"type": "null"}]}
      }
    },
    "CreatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_version", "base_session_version", "source_turn_id", "ledger_scope_id", "operation", "confidence", "presentation", "entries"],
      "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan_version": {"type": "integer", "minimum": 1},
        "base_session_version": {"type": "integer", "minimum": 0},
        "source_turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ledger_scope_id": {"const": "personal:primary"},
        "operation": {"const": "create"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "presentation": {"$ref": "#/$defs/FinancePresentation"},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/CreateEntry"}, "minItems": 1, "maxItems": 50}
      }
    },
    "QueryLikePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_version", "base_session_version", "source_turn_id", "ledger_scope_id", "operation", "confidence", "presentation", "filters"],
      "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan_version": {"type": "integer", "minimum": 1},
        "base_session_version": {"type": "integer", "minimum": 0},
        "source_turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ledger_scope_id": {"const": "personal:primary"},
        "operation": {"enum": ["query", "summarize"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "presentation": {"$ref": "#/$defs/FinancePresentation"},
        "temporal_scope": {"$ref": "#/$defs/TemporalScope"},
        "filters": {"$ref": "#/$defs/FinanceFilters"},
        "reference": {"anyOf": [{"$ref": "#/$defs/ReferenceSpec"}, {"type": "null"}]}
      }
    },
    "AnalyzePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_version", "base_session_version", "source_turn_id", "ledger_scope_id", "operation", "confidence", "presentation", "filters", "metric"],
      "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan_version": {"type": "integer", "minimum": 1},
        "base_session_version": {"type": "integer", "minimum": 0},
        "source_turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ledger_scope_id": {"const": "personal:primary"},
        "operation": {"const": "analyze"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "presentation": {"$ref": "#/$defs/FinancePresentation"},
        "temporal_scope": {"$ref": "#/$defs/TemporalScope"},
        "filters": {"$ref": "#/$defs/FinanceFilters"},
        "metric": {"enum": ["expense", "income", "net", "count", "category_share", "account_share", "trend"]},
        "dimension": {"enum": ["none", "date", "category", "account", "merchant"]}
      }
    },
    "ComparePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_version", "base_session_version", "source_turn_id", "ledger_scope_id", "operation", "confidence", "presentation", "left_scope", "right_scope", "metric"],
      "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan_version": {"type": "integer", "minimum": 1},
        "base_session_version": {"type": "integer", "minimum": 0},
        "source_turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ledger_scope_id": {"const": "personal:primary"},
        "operation": {"const": "compare"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "presentation": {"$ref": "#/$defs/FinancePresentation"},
        "left_scope": {"$ref": "#/$defs/TemporalScope"},
        "right_scope": {"$ref": "#/$defs/TemporalScope"},
        "filters": {"$ref": "#/$defs/FinanceFilters"},
        "metric": {"enum": ["expense", "income", "net", "count", "category_share", "account_share"]},
        "dimension": {"enum": ["none", "date", "category", "account", "merchant"]}
      }
    },
    "MutationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_version", "base_session_version", "source_turn_id", "ledger_scope_id", "operation", "confidence", "presentation", "selection"],
      "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan_version": {"type": "integer", "minimum": 1},
        "base_session_version": {"type": "integer", "minimum": 0},
        "source_turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ledger_scope_id": {"const": "personal:primary"},
        "operation": {"enum": ["update", "delete"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "presentation": {"$ref": "#/$defs/FinancePresentation"},
        "temporal_scope": {"anyOf": [{"$ref": "#/$defs/TemporalScope"}, {"type": "null"}]},
        "filters": {"$ref": "#/$defs/FinanceFilters"},
        "selection": {"$ref": "#/$defs/FinanceSelection"},
        "reference": {"anyOf": [{"$ref": "#/$defs/ReferenceSpec"}, {"type": "null"}]},
        "changes": {"anyOf": [{"$ref": "#/$defs/FinanceChanges"}, {"type": "null"}]}
      }
    },
    "RestorePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan_id", "plan_version", "base_session_version", "source_turn_id", "ledger_scope_id", "operation", "confidence", "presentation", "reference"],
      "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan_version": {"type": "integer", "minimum": 1},
        "base_session_version": {"type": "integer", "minimum": 0},
        "source_turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ledger_scope_id": {"const": "personal:primary"},
        "operation": {"const": "restore"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "presentation": {"$ref": "#/$defs/FinancePresentation"},
        "reference": {"$ref": "#/$defs/ReferenceSpec"}
      }
    },
    "FinancePlan": {
      "oneOf": [
        {"$ref": "#/$defs/CreatePlan"},
        {"$ref": "#/$defs/QueryLikePlan"},
        {"$ref": "#/$defs/AnalyzePlan"},
        {"$ref": "#/$defs/ComparePlan"},
        {"$ref": "#/$defs/MutationPlan"},
        {"$ref": "#/$defs/RestorePlan"}
      ]
    },
    "PlanPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "base_plan_id", "base_plan_version", "base_session_version"],
      "properties": {
        "schema_version": {"const": 1},
        "base_plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "base_plan_version": {"type": "integer", "minimum": 1},
        "base_session_version": {"type": "integer", "minimum": 0},
        "operation": {"enum": ["query", "summarize", "analyze", "compare", "update", "delete", "restore"]},
        "temporal_scope": {"anyOf": [{"$ref": "#/$defs/TemporalScope"}, {"type": "null"}]},
        "filters": {"anyOf": [{"$ref": "#/$defs/FinanceFilters"}, {"type": "null"}]},
        "selection": {"anyOf": [{"$ref": "#/$defs/FinanceSelection"}, {"type": "null"}]},
        "changes": {"anyOf": [{"$ref": "#/$defs/FinanceChanges"}, {"type": "null"}]},
        "presentation": {"anyOf": [{"$ref": "#/$defs/FinancePresentation"}, {"type": "null"}]},
        "reference": {"anyOf": [{"$ref": "#/$defs/ReferenceSpec"}, {"type": "null"}]}
      }
    },
    "SafeCandidateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "date": {"type": ["string", "null"], "maxLength": 32},
        "amount_fen": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "ClarificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "message"],
      "properties": {
        "reason": {"enum": ["ambiguous_target", "missing_reference", "expired_reference", "stale_reference", "insufficient_scope", "unsupported_request", "ordering_conflict"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/SafeCandidateSummary"}, "maxItems": 5}
      }
    },
    "FinanceError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "safe_message"],
      "properties": {
        "code": {"enum": ["interpretation_failed", "clarification_required", "unauthorized", "forbidden_scope", "no_match", "ambiguous_target", "expired_reference", "stale_reference", "stale_turn", "ordering_conflict", "cardinality_mismatch", "invalid_money", "invalid_category", "invalid_account", "policy_rejected", "idempotency_conflict", "in_progress", "db_read_failed", "db_commit_failed", "provider_failed", "render_failed", "delivery_pending", "delivery_failed", "delivery_unknown", "result_too_large", "operation_too_large"]},
        "safe_message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "FinanceResultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id", "snapshot"],
      "properties": {
        "entity_type": {"enum": ["transaction", "transaction_item", "receipt_parent", "operation"]},
        "entity_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "entity_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "snapshot": {"type": "object"}
      }
    },
    "FinanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transaction_count": {"type": "integer", "minimum": 0},
        "expense_fen": {"type": "integer", "minimum": 0},
        "income_fen": {"type": "integer", "minimum": 0},
        "transfer_fen": {"type": "integer", "minimum": 0},
        "net_fen": {"type": "integer"}
      }
    },
    "FinanceAnalysisData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "summary"],
      "properties": {
        "metric": {"type": "string", "minLength": 1, "maxLength": 64},
        "summary": {"$ref": "#/$defs/FinanceSummary"},
        "dimensions": {"type": "array", "items": {"type": "object"}, "maxItems": 50}
      }
    },
    "FinanceComparisonData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "left", "right", "delta_fen"],
      "properties": {
        "metric": {"type": "string", "minLength": 1, "maxLength": 64},
        "left": {"$ref": "#/$defs/FinanceSummary"},
        "right": {"$ref": "#/$defs/FinanceSummary"},
        "delta_fen": {"type": "integer"},
        "delta_ratio": {"type": ["number", "null"]}
      }
    },
    "FinanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result_id", "turn_id", "operation", "interpretation_status", "policy_status", "execution_status", "commit_status", "replay_status", "delivery_status"],
      "properties": {
        "schema_version": {"const": 1},
        "result_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation": {"enum": ["create", "query", "summarize", "analyze", "compare", "update", "delete", "restore", "receipt_create"]},
        "interpretation_status": {"enum": ["accepted", "clarification", "failed", "not_applicable"]},
        "policy_status": {"enum": ["approved", "rejected", "not_applicable"]},
        "execution_status": {"enum": ["not_started", "executed", "failed"]},
        "commit_status": {"enum": ["not_required", "not_committed", "committed", "failed"]},
        "replay_status": {"enum": ["original", "replayed"]},
        "delivery_status": {"enum": ["not_required", "pending", "sending", "accepted", "failed_retryable", "failed_terminal", "unknown"]},
        "transaction_ids": {"type": "array", "items": {"type": "string", "maxLength": 128}, "maxItems": 50},
        "result_set_id": {"type": ["string", "null"], "maxLength": 128},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/FinanceResultRow"}, "maxItems": 20},
        "summary": {"anyOf": [{"$ref": "#/$defs/FinanceSummary"}, {"type": "null"}]},
        "analysis_data": {"anyOf": [{"$ref": "#/$defs/FinanceAnalysisData"}, {"type": "null"}]},
        "comparison_data": {"anyOf": [{"$ref": "#/$defs/FinanceComparisonData"}, {"type": "null"}]},
        "clarification": {"anyOf": [{"$ref": "#/$defs/ClarificationPayload"}, {"type": "null"}]},
        "error": {"anyOf": [{"$ref": "#/$defs/FinanceError"}, {"type": "null"}]}
      }
    },
    "ReceiptResolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "line_total_fen", "category", "confidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "quantity": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "unit_price_fen": {"type": ["integer", "null"], "minimum": 0},
        "line_total_fen": {"type": "integer", "minimum": 0},
        "category": {"type": "string", "minLength": 1, "maxLength": 64},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ReceiptReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items_total_fen", "receipt_total_fen", "delta_fen"],
      "properties": {
        "status": {"enum": ["matched", "within_rounding_tolerance", "mismatch", "incomplete"]},
        "items_total_fen": {"type": "integer", "minimum": 0},
        "receipt_total_fen": {"type": "integer", "minimum": 0},
        "delta_fen": {"type": "integer"},
        "tolerance_fen": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "ReceiptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_artifact_id", "job_id", "turn_id", "source_event_id", "attachment_ref", "provider", "provider_attempt_id", "total_fen", "currency", "items", "reconciliation", "validated_at", "artifact_hash"],
      "properties": {
        "schema_version": {"const": 1},
        "receipt_artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "attachment_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "provider": {"type": "string", "minLength": 1, "maxLength": 64},
        "provider_attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "merchant": {"type": ["string", "null"], "maxLength": 256},
        "total_fen": {"type": "integer", "minimum": 1},
        "currency": {"const": "CNY"},
        "occurred_at": {"type": ["string", "null"], "format": "date-time"},
        "payment_hint": {"type": ["string", "null"], "maxLength": 128},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ReceiptResolvedItem"}, "maxItems": 64},
        "reconciliation": {"$ref": "#/$defs/ReceiptReconciliation"},
        "validated_at": {"type": "string", "format": "date-time"},
        "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}