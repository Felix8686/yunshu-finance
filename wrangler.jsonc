{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wanxiang-cloud-dev",
  "main": "src/app.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_TIMEZONE": "Asia/Shanghai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "RECEIPT_VISION_MODEL": "@cf/qwen/qwen3.8-27b"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wanxiang-cloud-dev",
      "database_id": "67f7c38b-2def-4092-ae8a-e6bdfcd55cc3",
      "migrations_dir": "migrations"
    },
    {
      "binding": "SHADOW_DB",
      "database_name": "wanxiang-cloud-dev-shadow",
      "database_id": "a69881f7-7574-402f-ae14-743d42f1464b",
      "migrations_dir": "shadow-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "wanxiang-cloud-dev-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RECEIPT_QUEUE",
        "queue": "wanxiang-receipt-dev"
      }
    ],
    "consumers": [
      {
        "queue": "wanxiang-receipt-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2
      }
    ]
  }
}
